{
    "name": "yii3-ab-testing-family-docs",
    "private": true,
    "type": "module",
    "scripts": {
        "docs:aggregate": "node scripts/aggregate.mjs",
        "docs:api": "node scripts/generate-api.mjs",
        "docs:check": "node scripts/check-integrity.mjs",
        "docs:check:anchors": "node scripts/check-anchors.mjs",
        "docs:check:links": "node scripts/check-links.mjs",
        "docs:dev": "npm run docs:aggregate && npm run docs:api && vitepress dev .",
        "docs:build": "npm run docs:aggregate && npm run docs:api && npm run docs:check && vitepress build . && npm run docs:check:anchors",
        "docs:preview": "vitepress preview ."
    },
    "devDependencies": {
        "markdown-link-check": "^3.15.0",
        "vitepress": "^1.6.4"
    }
}
