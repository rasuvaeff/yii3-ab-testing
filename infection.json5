{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // Honest threshold, no ignored mutators. Three mutants are equivalent under
    // PHP semantics and cannot be killed by any test — see "Mutation testing"
    // in AGENTS.md for what they are and why. Raise this back to 100 only if
    // the code changes so those three disappear.
    "minMsi": 99,
    "mutators": {
        "@default": true
    }
}
