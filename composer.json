{
    "name": "rasuvaeff/yii3-ab-testing",
    "description": "Deterministic A/B testing for Yii3 applications",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "ab-testing",
        "experiment",
        "feature-flag",
        "split-testing",
        "yii3"
    ],
    "authors": [
        {
            "name": "Victor Razuvaev",
            "email": "rasuvaeff@gmail.com"
        }
    ],
    "homepage": "https://github.com/rasuvaeff/yii3-ab-testing",
    "support": {
        "issues": "https://github.com/rasuvaeff/yii3-ab-testing/issues",
        "source": "https://github.com/rasuvaeff/yii3-ab-testing"
    },
    "require": {
        "php": "8.3 - 8.5",
        "psr/clock": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.51",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.33",
        "maglnet/composer-require-checker": "^4.17",
        "ramsey/uuid": "^4.7",
        "rasuvaeff/property-testing": "^2.8",
        "rector/rector": "^2.4",
        "roave/backward-compatibility-check": "^8.0",
        "symfony/uid": "^6.4 || ^7.0",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.25",
        "vimeo/psalm": "^6.16",
        "yiisoft/di": "^1.2.1",
        "yiisoft/test-support": "^3.0"
    },
    "suggest": {
        "ramsey/uuid": "Bind RamseyUuidEventIdGenerator to mint event ids with ramsey/uuid instead of the built-in generator",
        "symfony/uid": "Bind SymfonyUidEventIdGenerator to mint event ids with symfony/uid instead of the built-in generator"
    },
    "autoload": {
        "psr-4": {
            "Rasuvaeff\\Yii3AbTesting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rasuvaeff\\Yii3AbTesting\\Benchmarks\\": "benchmarks/",
            "Rasuvaeff\\Yii3AbTesting\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "platform": {
            "ext-bcmath": "1.0.0",
            "ext-intl": "1.0.0"
        },
        "sort-packages": true
    },
    "extra": {
        "config-plugin": {
            "di": "di.php",
            "params": "params.php"
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "skills": {
            "source": "resources/skills"
        }
    },
    "scripts": {
        "bc-check": "roave-backward-compatibility-check",
        "bench": "testo --suite=Benchmarks -vv",
        "build": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "@require-checker",
            "@cs",
            "@psalm",
            "@test"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
        "cs:fix": "php-cs-fixer fix --diff --config=.php-cs-fixer.php",
        "mutation": "infection --threads=max",
        "psalm": "psalm --no-cache",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "release-check": [
            "@build",
            "@rector",
            "@bc-check"
        ],
        "require-checker": "composer-require-checker check composer.json",
        "test": "testo --suite=Unit",
        "test:coverage": "testo --suite=Unit --coverage --coverage-clover=build/coverage.xml",
        "test:coverage:ci": "testo --suite=Unit --coverage-clover=build/coverage.xml"
    }
}
